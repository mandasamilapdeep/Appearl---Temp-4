<style>
  .wireframe-container {
    display: grid;
    place-items: center;
  }

  .wireframe-inner-container {
    place-content: center;
    position: relative;
    overflow: hidden;
    --position: 50%;
  }

  .wireframe-image-container {
    max-width: 1800px;
    max-height: 700px;
    aspect-ratio: 2/1;
  }

  .wireframe-slider-image, .wireframe-image-before .placeholder-svg, .wireframe-image-after .placeholder-svg {
    width: 1800px;
    height: 700px;
    object-fit: cover;
    object-position: left;
    display: block;
    max-width: 100%;
  }

  .wireframe-image-before {
        position: absolute;
        inset: 0;
        width: var(--position);
        border-right: 2px solid #fff;
    }

  .wireframe-slider {
    position: absolute;
    inset: 0;
    cursor: ew-resize;
    opacity: 0;
    width: 100%;
    height: 100%;
}

  .wireframe-slider:focus-visible ~ .slider-button {
    outline: 5px solid black;
    outline-offset: 3px;
  }

  .wireframe-slider-line {
    position: absolute;
    inset: 0;
    width: 0.2rem;
    height: 100%;
    background-color: #000;
    /* z-index: 10; */
    left: var(--position);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .wireframe-slider-button {
    position: absolute;
    background-color: #fff;
    color: black;
    padding: 0.5rem;
    border-radius: 100vw;
    display: grid;
    place-items: center;
    top: 50%;
    left: var(--position);
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 1;
    box-shadow: 1px 1px 1px hsl(0, 50%, 2%, 0.5);
  }
  .before_after_section_main .title_box.page-width {
        text-align: center;
    }
    .before_after_section_main .title {
        margin-top: 0;
        margin-bottom: 40px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  
    @media screen and (max-width: 1280px) {
      .wireframe-image-container {
            max-height: 600px;
        }
        .wireframe-slider-image, .wireframe-image-before .placeholder-svg, .wireframe-image-after .placeholder-svg {
            width: 1280px;
            height: 600px;
        }
    }

    @media screen and (max-width: 1024px) {
      .wireframe-image-container {
            max-height: 500px;
        }
        .wireframe-slider-image, .wireframe-image-before .placeholder-svg, .wireframe-image-after .placeholder-svg {
            width: 1280px;
            height: 500px;
        }
    }
     

  @media screen and (max-width: 750px) {
    .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
        padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
  }
  @media screen and (max-width: 480px) {
      .wireframe-image-container {
            max-height: 220px;
        }
        .wireframe-slider-image, .wireframe-image-before .placeholder-svg, .wireframe-image-after .placeholder-svg {
            width: 550px;
            height: 220px;
        }
    }
</style>
{%- liquid
              assign sizes = '100vw'
              assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
            -%}
<div class="before_after_section_main section-{{ section.id }}-padding">    
<div class="title_box page-width">
    {% if section.settings.sub_title != blank %}
    <p class="sub_title">{{ section.settings.sub_title }}</p>
    {% endif %}
    {% if section.settings.title != blank %}
    <h3 class="h2 title">{{ section.settings.title }}</h3>
    {% endif %}
</div>            
<div class="page-width">
<div class="wireframe-container">
  <div class="wireframe-inner-container">
    <div class="wireframe-image-container">
      <div class="wireframe-image-before"> 
        {% if section.settings.before_image != blank %}
       {%- liquid
                    assign height = section.settings.before_image.width | divided_by: section.settings.before_image.aspect_ratio | round
                  -%}
        {{
            section.settings.before_image
            | image_url: width: 3840
            | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths, class: 'wireframe-slider-image'
        }}
     {% else %}
        
        {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
     {% endif %}  
      </div> 
      <div class="wireframe-image-after">
      {% if section.settings.after_image != blank %}
       {%- liquid
                    assign height = section.settings.after_image.width | divided_by: section.settings.after_image.aspect_ratio | round
                  -%}
        {{
            section.settings.after_image
            | image_url: width: 3840
            | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths, class: 'wireframe-slider-image'
        }}
     {% else %}
        
        {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
     {% endif %} 
      </div> 
    </div>
    <!-- step="10" -->
    <input
      type="range"
      min="0"
      max="100"
      value="50"
      aria-label="Percentage of before photo shown"
      class="wireframe-slider"
    />
    <div class="wireframe-slider-line" aria-hidden="true"></div>
    <div class="wireframe-slider-button" aria-hidden="true">
      <svg role="presentation" focusable="false" fill="none" width="50" height="50" viewBox="0 0 50 50">
              <g>
                <rect width="50" height="50" rx="25" fill="#ffffff"></rect>
                <path d="m19.25 19-6 6 6 6m11.5 0 6-6-6-6" stroke="#000000" stroke-width=".75" stroke-linecap="square"></path>
              </g>
            </svg>
    </div>
  </div>
</div>
</div>
</div>
<script>
  const container = document.querySelector('.wireframe-inner-container');
  document.querySelector('.wireframe-slider').addEventListener('input', (e) => {
    container.style.setProperty('--position', `${e.target.value}%`);
  });
</script>
{% schema %}
{
  "name": "Before after",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "sub_title",
      "label": "Sub heading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading"
    },
    {
        "type": "image_picker",
        "id": "before_image",
        "label": "Before image"
    },
    {
        "type": "image_picker",
        "id": "after_image",
        "label": "After image"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Before after"
    }
  ]
}
{% endschema %}
