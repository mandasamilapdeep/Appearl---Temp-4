<style>
  .marquee-wrapper_{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.border_top_color != blank %}
    border-top: 1px solid {{ section.settings.border_top_color }};
    {% endif %}
    {% if section.settings.border_bottom_color != blank %}
    border-bottom: 1px solid {{ section.settings.border_bottom_color }};
    {% endif %}


    --marquee-width: 100%;
    --marquee-elements-displayed: {{ section.settings.marquee_elemements_display_desktop }};
    --marquee-element-width: calc(var(--marquee-width) / var(--marquee-elements-displayed));
    --marquee-animation-duration: calc(var(--marquee-elements) * {{ section.settings.marquee_speed_desktop }}s);
  }

  .marquee-wrapper {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .marquee {
    width: var(--marquee-width);
    overflow: hidden;
    position: relative;
  }

  .marquee-content {
    list-style: none;
    height: 100%;
    display: flex;
    align-items: center;
    animation: scrolling var(--marquee-animation-duration) linear infinite;
    padding: 0;
    margin: 0;
  }

  .marquee.reverse .marquee-content {
    animation: scrolling-reverse var(--marquee-animation-duration) linear infinite;
  }

  @keyframes scrolling {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-1 * var(--marquee-element-width) * var(--marquee-elements)));
    }
  }

  @keyframes scrolling-reverse {
    0% {
      transform: translateX(calc(-1 * var(--marquee-element-width) * var(--marquee-elements)));
    }
    100% {
      transform: translateX(0);
    }
  }

  .marquee-wrapper_{{ section.id }} .marquee-content li {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--marquee-element-width);
    min-width: max-content;
    height: 100%;
    padding: 0 calc({{ section.settings.desktop_gap }}px / 2);
    gap: {{ section.settings.desktop_gap }}px;
    font-size: {{ section.settings.marquee_font_size_desktop }}px;

  }
  .marquee-wrapper_{{ section.id }} .marquee-content li a{
    display: flex;
    align-items: center;
    height: 100%;
    gap: {{ section.settings.desktop_gap }}px;
    text-decoration: none;
    color: inherit;
    white-space: nowrap;

  }

  .marquee-wrapper_{{ section.id }} .marquee-content li img {
    width: {{ section.settings.marquee_image_width_desktop }}px;
    height: auto;
  }

  @media (max-width: 768px) {
    .marquee-wrapper_{{ section.id }} {
      --marquee-elements-displayed: {{ section.settings.marquee_elemements_display_mobile }};
       --marquee-animation-duration: calc(var(--marquee-elements) * {{ section.settings.marquee_speed_mobile }}s);
    }


    .marquee-wrapper_{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    .marquee-wrapper_{{ section.id }} .marquee-content li {
      font-size: {{ section.settings.marquee_font_size_mobile }}px;
      padding: 0 calc({{ section.settings.mobile_gap }}px / 2);
      gap: {{ section.settings.mobile_gap }}px;
    }

    .marquee-wrapper_{{ section.id }} .marquee-content li a{
      gap: {{ section.settings.mobile_gap }}px;
    }

    .marquee-wrapper_{{ section.id }} .marquee-content li img {
      width: {{ section.settings.marquee_image_width_mobile }}px;
    }
  }
</style>

<div class="marquee-wrapper marquee-wrapper_{{ section.id }}">
  <div class="logo-row">
    <div class="marquee marquee_{{ section.id }} {% if section.settings.marquee_reverse %} reverse {% endif %}">
      <ul class="marquee-content">
        {% for block in section.blocks %}
          <li>
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}">
            {% endif %}
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 120 | image_tag: alt: block.settings.image.alt }}
            {% endif %}
            {% if block.settings.text != blank %}
              <span style="color:{{ block.settings.text_color }}; font-size:{{ block.settings.text_font_size }}px;">
                {{- block.settings.text -}}
              </span>
            {% endif %}
            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('.marquee_{{ section.id }}').forEach((marquee) => {
    const wrapper = marquee.closest('.marquee-wrapper_{{ section.id }}');
    const content = marquee.querySelector('.marquee-content');

    if (!wrapper || !content) return;

    const displayed = parseFloat(getComputedStyle(wrapper).getPropertyValue('--marquee-elements-displayed'));

    wrapper.style.setProperty('--marquee-elements', content.children.length);

    for (let i = 0; i < displayed; i++) {
      content.appendChild(content.children[i].cloneNode(true));
    }
  });
</script>

{% schema %}
{
  "name": "Marquee",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "marquee_reverse",
      "label": "Marquee Reverse",
      "default": false
    },
    {
      "type": "range",
      "id": "marquee_elemements_display_desktop",
      "min": 1,
      "max": 10,
      "step": 0.5,
      "unit": "qty",
      "label": "Marquee elements to display (Desktop)",
      "default": 2
    },
    {
      "type": "range",
      "id": "marquee_elemements_display_mobile",
      "min": 1,
      "max": 10,
      "step": 0.5,
      "unit": "qty",
      "label": "Marquee elements to display (Mobile)",
      "default": 1
    },
    {
      "type": "range",
      "id": "marquee_speed_desktop",
      "min": 1,
      "max": 20,
      "step": 0.5,
      "unit": "sec",
      "label": "Marquee speed (Desktop)",
      "default": 6
    },
    {
      "type": "range",
      "id": "marquee_speed_mobile",
      "min": 1,
      "max": 20,
      "step": 0.5,
      "unit": "sec",
      "label": "Marquee speed (Mobile)",
      "default": 4
    },
    {
      "type": "color",
      "id": "border_top_color",
      "label": "Border top color"
    },
    {
      "type": "color",
      "id": "border_bottom_color",
      "label": "Border bottom color"
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Desktop gap between elements",
      "min": 8,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap between elements",
      "min": 8,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "range",
      "id": "marquee_font_size_desktop",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Text font size (desktop)",
      "default": 36
    },
    {
      "type": "range",
      "id": "marquee_font_size_mobile",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Text font size (mobile)",
      "default": 36
    },
    {
      "type": "range",
      "id": "marquee_image_width_desktop",
      "min": 10,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Image width (desktop)",
      "default": 80
    },
    {
      "type": "range",
      "id": "marquee_image_width_mobile",
      "min": 10,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Image width (mobile)",
      "default": 60
    }
  ],
  "max_blocks": 5,
  "blocks": [
    {
      "name": "Slide",
      "type": "slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#000000"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
