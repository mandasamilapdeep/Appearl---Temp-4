{%- style -%}
  .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px; 
    }

  @media screen and (max-width: 750px) {
    .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
        padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
  }
{%- endstyle -%}
{%- liquid
              assign sizes = '100vw'
              assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
            -%}
<div class="images_text_main section-{{ section.id }}-padding">
    <div class="page-width">
        <div class="images_text_inner">
            <div class="text_box" >
             <div class="text_box_inner" style="max-width: {{ section.settings.text_box_max_width }}px">
                {% if section.settings.sub_title != blank %}
                <p class="sub_title">{{ section.settings.sub_title }}</p>
                {% endif %}
                {% if section.settings.title != blank %}
                <h3 class="h2">{{ section.settings.title }}</h3>
                {% endif %}
                {% if section.settings.text != blank %}
                <div class="text rte">
                    {{ section.settings.text }}
                </div>
            {%  endif %}
            {% if section.settings.button_link != blank  %}
                <a href="{{ section.settings.button_link }}" class="button button_hover_effect" aria-label="View all products in the Keffiyeh Vests collection">
                  {{ section.settings.button_text }}
                </a>
            {% endif %}
        </div>
            </div>
            <div class="images_box">
                <div class="images_box_inner">
                    <div class="first_image">
                        {% if section.settings.first_image != blank %}
                        {%- liquid
                                        assign height = section.settings.first_image.width | divided_by: section.settings.first_image.aspect_ratio | round
                                    -%}
                            {{
                                section.settings.first_image
                                | image_url: width: 3840
                                | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths
                            }}
                        {% else %}
                            
                            {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
                        {% endif %} 
                    </div>
                    <div class="second_image">
                        {% if section.settings.second_image != blank %}
                        {%- liquid
                                        assign height = section.settings.second_image.width | divided_by: section.settings.second_image.aspect_ratio | round
                                    -%}
                            {{
                                section.settings.second_image
                                | image_url: width: 3840
                                | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths
                            }}
                        {% else %}
                            
                            {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
                        {% endif %} 
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% schema %}
{
  "name": "Images with text",
  "tag": "section",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "sub_title",
      "label": "Sub heading"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
        "type": "image_picker",
        "id": "first_image",
        "label": "First image"
    },
    {
        "type": "image_picker",
        "id": "second_image",
        "label": "Second image"
    },
    {
      "type": "range",
      "id": "text_box_max_width",
      "min": 200,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Text box max width",
      "default": 500
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Images with text"
    }
  ]
}
{% endschema %}