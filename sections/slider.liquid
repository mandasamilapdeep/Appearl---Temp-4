{% style %}
  #slider_wrapper_{{ section.id }} {
      height: {{ section.settings.slide_height_desktop }};
  }

  @media(max-width: 768px) {
      #slider_wrapper_{{ section.id }} {
        height: {{ section.settings.slide_height_mobile }};
      }
  }
{% endstyle %}

<div id="slider_wrapper_{{ section.id }}" class="slider_section_wrapper ">
  <div class="swiper animeslide slider_main animeslide-{{ section.id }}">
    <!-- Additional required wrapper -->
    <div class="swiper-wrapper">
      <!-- Slides -->
      {% for block in section.blocks %}
        <style>
          #slide_inner_content_{{ section.id }}_{{ block.id }}:after {
            content: "";
            position: absolute;
            background-color: {{ block.settings.overlay_color }};
            opacity: {{ block.settings.overlay_opacity }};
            width: 100%;
            height: 100%;
          }

          #slide_inner_content_{{ section.id }}_{{ block.id }} .container {
            max-width: {{ block.settings.slide_text_max_width }}px;
            background-color: {{ block.settings.slide_text_bg_color }};

            {% if block.settings.slide_text_border_color != blank or block.settings.slide_text_bg_color != blank %}
            {% if block.settings.slide_text_border_color != blank %}  
            border: 1px solid {{ block.settings.slide_text_border_color }};
            {% endif %}
             width: calc(100% - 30px);
            {% else %}
              width: 100%;
            {% endif %}
          }
          .button_box_{{ section.id }}_{{ block.id }} .button_1 {
            --initial-gradient: linear-gradient({{ block.settings.button_1_bg_color }}, {{ block.settings.button_1_bg_color }});
            --hover-gradient: linear-gradient(transparent, transparent);
            background-image: var(--initial-gradient), var(--hover-gradient);
            color: {{ block.settings.button_1_text_color }};
            border-color: {{ block.settings.button_1_border_color }};
          }
          .button_box_{{ section.id }}_{{ block.id }} .button_2 {
            --initial-gradient: linear-gradient({{ block.settings.button_2_bg_color }}, {{ block.settings.button_2_bg_color }});
            --hover-gradient: linear-gradient(transparent, transparent);
            background-image: var(--initial-gradient), var(--hover-gradient);
            color: {{ block.settings.button_2_text_color }};
            border-color: {{ block.settings.button_2_border_color }};
          }
          .button_box_{{ section.id }}_{{ block.id }} .button_1:hover {
            color: {{ block.settings.button_1_hover_text_color }};
            border-color: {{ block.settings.button_1_hover_border_color }};
          }
          .button_box_{{ section.id }}_{{ block.id }} .button_2:hover {
            color: {{ block.settings.button_2_hover_text_color }};
            border-color: {{ block.settings.button_2_hover_border_color }};
          }
        </style>
        <div
          class="swiper-slide animeslide-slide"
        >
          <div id="slide_inner_content_{{ section.id }}_{{ block.id }}" class="slide_inner_content">
            {%- liquid
              assign sizes = '100vw'
              assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
            -%}

            <div class="slider_image_box {% if block.settings.video_mob != blank %} mobile_video_true {% endif %} {% if block.settings.image_mob != blank %} mobile_image_true {% endif %}">
              {% if block.settings.video_desk != blank %}
                {{
                  block.settings.video_desk
                  | video_tag: autoplay: true, loop: true, controls: false, muted: true, class: 'desktop_video'
                }}
                {% if block.settings.video_mob != blank %}
                  {{
                    block.settings.video_mob
                    | video_tag: autoplay: true, loop: true, controls: false, muted: true, class: 'mobile_video'
                  }}
                {% endif %}
              {% else %}
                {% if block.settings.image_desk != blank %}
                  {%- liquid
                    assign height = block.settings.image_desk.width | divided_by: block.settings.image_desk.aspect_ratio | round
                  -%}
                  {{
                    block.settings.image_desk
                    | image_url: width: 3840
                    | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths, class: 'desktop_image'
                  }}

                  {% if block.settings.image_mob != blank %}
                    {%- liquid
                      assign height = block.settings.image_mob.width | divided_by: block.settings.image_mob.aspect_ratio | round
                    -%}
                    {{
                      block.settings.image_mob
                      | image_url: width: 3840
                      | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths, class: 'mobile_image'
                    }}
                  {% endif %}
                {% else %}
                  {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              {% endif %}
            </div>

            <div class="container {{ block.settings.slide_text_position_desktop }}  {{ block.settings.slide_text_position_mobile }}">
              <div class="container_inner {{ block.settings.slide_text_align }}">
                {% if block.settings.subheading != blank %}
                  <div
                    style="color: {{ block.settings.sub_heading_color }};"
                    data-animate="bottom"
                    class="animeslide-desc rte"
                  >
                    {{ block.settings.subheading }}
                  </div>
                {% endif %}

                {% if block.settings.text != blank %}
                  <div
                    style="color: {{ block.settings.text_color }};"
                    data-animate="bottom"
                    class="animeslide-desc rte slide_text"
                  >
                    {{ block.settings.text }}
                  </div>
                {% endif %}

                {% if block.settings.heading != blank %}
                  <h2
                    style="color: {{ block.settings.heading_color }};"
                    data-animate="bottom"
                    class="animeslide-heading {{ block.settings.heading_size }}"
                  >
                    {{ block.settings.heading }}
                  </h2>
                {% endif %}
                 {% if block.settings.button_1_url != blank or block.settings.button_2_url != blank %}
                <div
                  data-animate="bottom"
                  class="animeslide-desc button_box button_box_{{ section.id }}_{{ block.id }}"
                >
                  {% if block.settings.button_1_url != blank %}
                    <a
                      href="{{ block.settings.button_1_url }}"
                      class="button  button_1 button_hover_effect"
                    >
                      {{ block.settings.button_1_text -}}
                    </a>
                  {% endif %}
                  {% if block.settings.button_2_url != blank %}
                    <a
                      href="{{ block.settings.button_2_url }}"
                      class="button  button_2 button_hover_effect"
                    >
                      {{ block.settings.button_2_text -}}
                    </a>
                  {% endif %}
                </div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <div class="flex animeslide-bottom {% unless section.settings.show_scrollbar or section.settings.show_arrows %} small_width_scrollbar {% endunless %}">
        <div class="cell small">
          {% if section.settings.show_dots %}
            <div class="animeslide-pagination swiper-pagination animeslide-pagination-{{ section.id }}"></div>
          {% endif %}
        </div>

        {% if section.settings.show_scrollbar %}
          <div class="cell medium">
            <div class="animeslide-scrollbar swiper-scrollbar"></div>
          </div>
        {% endif %}

        {% if section.settings.show_arrows %}
          <div class="cell small">
            <div class="animeslide-button-prev swiper-button-prev"></div>
            <div class="animeslide-button-next swiper-button-next"></div>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

<script>
  (function () {

    function initSwiper{{ section.id | replace: '-', '_' }}() {

      const slider = document.querySelector('.animeslide-{{ section.id }}');
      if (!slider) return;

      // Prevent duplicate initialization
      if (slider.swiper) {
        slider.swiper.destroy(true, true);
      }

      new Swiper(slider, {
        effect: 'fade',
        loop: false,
        speed: 900,
        centeredSlides: true,

        {% if section.settings.show_dots %}
        pagination: {
          el: '.animeslide-pagination-{{ section.id }}',
          clickable: true,
        },
        {% endif %}

        navigation: {
          nextEl: '.animeslide-button-next',
          prevEl: '.animeslide-button-prev',
        },

        scrollbar: {
          el: '.animeslide-scrollbar',
          draggable: true,
        },

        keyboard: {
          enabled: true,
          onlyInViewport: false,
        },

        {% if section.settings.enable_autoplay %}
        autoplay: {
          delay: {{ section.settings.autoplay_speed }}000,
          disableOnInteraction: false,
          pauseOnMouseEnter: true,
        },
        {% endif %}

        runCallbacksOnInit: true,
      });
    }

    document.addEventListener('DOMContentLoaded', initSwiper{{ section.id | replace: '-', '_' }});
    document.addEventListener('shopify:section:load', initSwiper{{ section.id | replace: '-', '_' }});

  })();
</script>

