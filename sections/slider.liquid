{% style %}
  #slider_wrapper_{{ section.id }} {
      height: {{ section.settings.slide_height_desktop }};
  }

  @media(max-width: 768px) {
      #slider_wrapper_{{ section.id }} {
        height: {{ section.settings.slide_height_mobile }};
      }
  }
{% endstyle %}

<div id="slider_wrapper_{{ section.id }}" class="slider_section_wrapper ">
  <div class="swiper animeslide slider_main animeslide-{{ section.id }}">
    <!-- Additional required wrapper -->
    <div class="swiper-wrapper">
      <!-- Slides -->
      {% for block in section.blocks %}
        <div
          class="swiper-slide animeslide-slide"
        >
          <div class="slide_inner_content">
            {%- liquid
              assign sizes = '100vw'
              assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
            -%}

            <div class="slider_image_box {% if block.settings.video_mob != blank %} mobile_video_true {% endif %} {% if block.settings.image_mob != blank %} mobile_image_true {% endif %}">
              {% if block.settings.video_desk != blank %}
                {{
                  block.settings.video_desk
                  | video_tag: autoplay: true, loop: true, controls: true, muted: true, class: 'desktop_video'
                }}
                {% if block.settings.video_mob != blank %}
                  {{
                    block.settings.video_mob
                    | video_tag: autoplay: true, loop: true, controls: true, muted: true, class: 'mobile_video'
                  }}
                {% endif %}
              {% else %}
                {% if block.settings.image_desk != blank %}
                  {%- liquid
                    assign height = block.settings.image_desk.width | divided_by: block.settings.image_desk.aspect_ratio | round
                  -%}
                  {{
                    block.settings.image_desk
                    | image_url: width: 3840
                    | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths, class: 'desktop_image'
                  }}

                  {% if block.settings.image_mob != blank %}
                    {%- liquid
                      assign height = block.settings.image_mob.width | divided_by: block.settings.image_mob.aspect_ratio | round
                    -%}
                    {{
                      block.settings.image_mob
                      | image_url: width: 3840
                      | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths, class: 'mobile_image'
                    }}
                  {% endif %}
                {% else %}
                  {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              {% endif %}
            </div>

            <div class="container">
              <h2 data-animate="bottom" class="animeslide-heading">
                Why do we use it <br>
                <span>Lorem Ipsum is simply dummy text</span>
              </h2>

              <p data-animate="bottom" class="animeslide-desc">
                Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the
                industry's standard dummy text ever since the 1500s.
              </p>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <div class="flex animeslide-bottom">
        <div class="cell small">
          {% if section.settings.show_dots %}
            <div class="animeslide-pagination swiper-pagination animeslide-pagination-{{ section.id }}"></div>
          {% endif %}
        </div>

        <div class="cell medium">
          <div class="animeslide-scrollbar swiper-scrollbar"></div>
        </div>

        <div class="cell small">
          <div class="animeslide-button-prev swiper-button-prev"></div>
          <div class="animeslide-button-next swiper-button-next"></div>
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% comment %}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
    const swiperQuiz{{ section.id | replace: '-', '_' }} = new Swiper('.animeslide-{{ section.id }}', {
      effect: 'fade',
      loop: true,
      speed: 900,
      centeredSlides: true,

      {% if section.settings.show_dots %}
      pagination: {
        el: '.animeslide-pagination-{{ section.id }}',
        clickable: true,
      },
      {% endif %}

      navigation: {
        nextEl: '.animeslide-button-next',
        prevEl: '.animeslide-button-prev',
      },

      scrollbar: {
        el: '.animeslide-scrollbar',
        draggable: true,
      },

      keyboard: {
        enabled: true,
        onlyInViewport: false,
      },

      {% if section.settings.enable_autoplay %}
      autoplay: {
        delay: {{ section.settings.autoplay_speed }},
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      },
      {% endif %}

      runCallbacksOnInit: true,
    });
    });
  </script>
{% endcomment %}

<script>
  (function () {

    function initSwiper{{ section.id | replace: '-', '_' }}() {

      const slider = document.querySelector('.animeslide-{{ section.id }}');
      if (!slider) return;

      // Prevent duplicate initialization
      if (slider.swiper) {
        slider.swiper.destroy(true, true);
      }

      new Swiper(slider, {
        effect: 'fade',
        loop: false,
        speed: 900,
        centeredSlides: true,

        {% if section.settings.show_dots %}
        pagination: {
          el: '.animeslide-pagination-{{ section.id }}',
          clickable: true,
        },
        {% endif %}

        navigation: {
          nextEl: '.animeslide-button-next',
          prevEl: '.animeslide-button-prev',
        },

        scrollbar: {
          el: '.animeslide-scrollbar',
          draggable: true,
        },

        keyboard: {
          enabled: true,
          onlyInViewport: false,
        },

        {% if section.settings.enable_autoplay %}
        autoplay: {
          delay: {{ section.settings.autoplay_speed }}000,
          disableOnInteraction: false,
          pauseOnMouseEnter: true,
        },
        {% endif %}

        runCallbacksOnInit: true,
      });
    }

    document.addEventListener('DOMContentLoaded', initSwiper{{ section.id | replace: '-', '_' }});
    document.addEventListener('shopify:section:load', initSwiper{{ section.id | replace: '-', '_' }});

  })();
</script>

{% schema %}
{
  "name": "Slider",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Slideshow"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show Dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay Speed",
      "min": 1,
      "max": 9,
      "step": 1,
      "unit": "sec",
      "default": 5
    },
    {
      "type": "select",
      "id": "slide_height_desktop",
      "options": [
        {
          "value": "40vh",
          "label": "Small"
        },
        {
          "value": "60vh",
          "label": "Medium"
        },
        {
          "value": "80vh",
          "label": "Large"
        },
        {
          "value": "100vh",
          "label": "Full Screen"
        }
      ],
      "default": "60vh",
      "label": "Height desktop"
    },
    {
      "type": "select",
      "id": "slide_height_mobile",
      "options": [
        {
          "value": "40vh",
          "label": "Small"
        },
        {
          "value": "60vh",
          "label": "Medium"
        },
        {
          "value": "80vh",
          "label": "Large"
        },
        {
          "value": "100vh",
          "label": "Full Screen"
        }
      ],
      "default": "60vh",
      "label": "Height mobile"
    }
  ],
  "max_blocks": 5,
  "blocks": [
    {
      "name": "Slide",
      "type": "slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desk",
          "label": "Image desktop"
        },
        {
          "type": "image_picker",
          "id": "image_mob",
          "label": "Image mobile"
        },
        {
          "type": "video",
          "id": "video_desk",
          "label": "Video desktop"
        },

        {
          "type": "video",
          "id": "video_mob",
          "label": "Video mobile"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slider",
      "settings": {
        "title": "Slider"
      },
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["*"],
    "groups": ["footer"]
  }
}
{% endschema %}
